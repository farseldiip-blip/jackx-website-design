{
  "name": "jackx-website",
  "version": "1.0.0",
  "private": true,
  "description": "JACKX — coffee, food and moments by the Nile in Damietta. Static site for GitHub Pages.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
